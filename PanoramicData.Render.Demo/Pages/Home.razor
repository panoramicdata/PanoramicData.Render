@page "/"
@using System.IO.Compression
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using PanoramicData.Render
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>PanoramicData Render Demo</PageTitle>

<div class="demo-shell">
	<div class="mode-tabs" role="tablist" aria-label="Mode selector">
		<button class="mode-tab @GetModeTabCss(AppMode.SimpleRender)" @onclick="() => SetMode(AppMode.SimpleRender)">Simple Render</button>
		<button class="mode-tab @GetModeTabCss(AppMode.Comparison)" @onclick="() => SetMode(AppMode.Comparison)">Comparison Workspace</button>
	</div>

	@if (!string.IsNullOrWhiteSpace(_errorMessage))
	{
		<div class="alert alert-danger" role="alert">@_errorMessage</div>
	}

	@if (_activeMode == AppMode.SimpleRender)
	{
		<section class="simple-mode">
			<p class="demo-subtitle">Drop or upload a DOCX and render it to SVG pages (with optional PDF download).</p>
			<div class="intake compact">
				<InputFile class="file-input-overlay"
					OnChange="OnSimpleDocxSelected"
					accept=".docx,.dotx" />
				<div class="intake-content">
					<span class="load-icon" aria-hidden="true"></span>
					<strong>DOCX / DOTX file</strong>
					<span>@(_docxFile is null ? "Drop or click to browse" : DescribeFile(_docxFile))</span>
				</div>
			</div>
			<div class="actions">
				<button class="btn btn-primary" @onclick="RenderSimpleAsync" disabled="@(!_canSimpleRender)">Render</button>
				<button class="btn btn-outline-secondary" @onclick="DownloadPdfAsync" disabled="@(_renderResult is null || _isRendering)">Download PDF</button>
			</div>

			@if (_pages.Count > 0)
			{
				<section class="page-strip" aria-label="Rendered pages">
					@foreach (var renderedPage in _pages)
					{
						<article class="page-card">
							<header>Page @renderedPage.PageNumber</header>
							<div class="page-canvas" style="width:@($"{renderedPage.DisplayWidthPx:F0}px");height:@($"{renderedPage.DisplayHeightPx:F0}px")">
								@((MarkupString)renderedPage.SvgMarkup)
							</div>
						</article>
					}
				</section>
			}
		</section>
	}
	else
	{
		<section class="comparison-mode">
			<p class="demo-subtitle">Comparison is the primary workflow. Upload DOCX and PDF directly on the column headers, then render.</p>

			<div class="comparison-grid">
				<div class="comparison-header header-workspace">
					<div class="header-cell upload-cell">
						<div class="header-title">Reference (PDF)</div>
						<div class="intake compact">
							<InputFile class="file-input-overlay"
								OnChange="OnComparisonPdfSelected"
								accept=".pdf" />
							<div class="intake-content small">
								<span class="load-icon" aria-hidden="true"></span>
								<strong>Drop or upload PDF</strong>
								<span>@(_pdfFile is null ? "No PDF selected" : DescribeFile(_pdfFile))</span>
							</div>
						</div>
					</div>
					<div class="header-cell upload-cell">
						<div class="header-title">Rendered (SVG from DOCX)</div>
						<div class="intake compact">
							<InputFile class="file-input-overlay"
								OnChange="OnComparisonDocxSelected"
								accept=".docx,.dotx" />
							<div class="intake-content small">
								<span class="load-icon" aria-hidden="true"></span>
								<strong>Drop or upload DOCX</strong>
								<span>@(_docxFile is null ? "No DOCX selected" : DescribeFile(_docxFile))</span>
							</div>
						</div>
					</div>
					<div class="header-cell actions-cell">
						<div class="header-title">Difference</div>
						<div class="actions vertical">
							<button class="btn btn-primary" @onclick="RenderComparisonAsync" disabled="@(!_canCompareRender)">Render + Compare</button>
							<button class="btn btn-outline-secondary" @onclick="DownloadPdfAsync" disabled="@(_renderResult is null || _isRendering)">Download PDF</button>
						</div>
					</div>
					<div class="header-cell actions-cell">
						<div class="header-title">Issues + Assessment</div>
						<div class="actions vertical">
							<button class="btn btn-outline-primary" @onclick="ExportWorkspaceZipAsync" disabled="@(!_canExportWorkspace)">Export ZIP</button>
							<div class="intake compact tiny">
								<InputFile class="file-input-overlay"
									OnChange="OnWorkspaceZipSelected"
									accept=".zip" />
								<div class="intake-content small">
									<span class="load-icon" aria-hidden="true"></span>
									<strong>Import ZIP</strong>
									<span>@(_workspaceImportName is null ? "Drop or upload" : _workspaceImportName)</span>
								</div>
							</div>
						</div>
					</div>
				</div>

				@if (_comparisonRows.Count == 0)
				{
					<div class="comparison-row">
						<div class="comparison-cell"><div class="placeholder">Reference page preview appears here</div></div>
						<div class="comparison-cell"><div class="placeholder">Rendered SVG page appears here</div></div>
						<div class="comparison-cell"><div class="placeholder">Pixel diff appears here</div></div>
						<div class="comparison-cell"><div class="placeholder">Issues, notes, and assessment appear here</div></div>
					</div>
				}
				else
				{
					@foreach (var row in _comparisonRows)
					{
						<div class="comparison-row">
							<div class="comparison-cell">
								<header>Page @row.PageNumber</header>
								@if (row.ReferencePngDataUri is not null)
								{
									<img src="@row.ReferencePngDataUri" alt="Reference page @row.PageNumber" />
								}
								else
								{
									<div class="placeholder">No reference page</div>
								}
							</div>
							<div class="comparison-cell">
								<header>Page @row.PageNumber</header>
								@if (string.IsNullOrWhiteSpace(row.SvgMarkup))
								{
									<div class="placeholder">No rendered page</div>
								}
								else
								{
									<div class="svg-container" id="svg-page-@row.PageNumber">
										@((MarkupString)row.SvgMarkup)
									</div>
								}
							</div>
							<div class="comparison-cell">
								<header>
									Page @row.PageNumber
									@if (row.MatchPercent.HasValue)
									{
										<span class="match-badge @(row.MatchPercent >= 95 ? "good" : row.MatchPercent >= 80 ? "fair" : "poor")">
											@($"{row.MatchPercent:F1}% match")
										</span>
									}
								</header>
								@if (row.DiffPngDataUri is not null)
								{
									<img src="@row.DiffPngDataUri" alt="Diff page @row.PageNumber" />
								}
								else
								{
									<div class="placeholder">@(row.ReferencePngDataUri is null ? "Awaiting reference" : "Pending diff")</div>
								}
							</div>
							<div class="comparison-cell issues-cell">
								<header>Page @row.PageNumber review</header>
								<div class="issues-panel">
									@if (row.MatchPercent.HasValue)
									{
										<div class="assessment-card">
											<div class="assessment-title"><strong>Pixels</strong></div>
											<div class="assessment-metrics-inline">
												<div class="assessment-metric-row @GetSeverityCss(row.MissingFromSvgPercent)">
												<span>Red: @row.MissingFromSvgPercent.ToString("F1")%</span>
											</div>
												<div class="assessment-metric-row @GetSeverityCss(row.ExtraInSvgPercent)">
												<span>Cyan: @row.ExtraInSvgPercent.ToString("F1")%</span>
											</div>
												<div class="assessment-metric-row @GetSeverityCss(row.RecolorPercent)">
												<span>Grey: @row.RecolorPercent.ToString("F1")%</span>
											</div>
											</div>
										</div>
									}

									<textarea class="issue-notes"
										rows="2"
										placeholder="Page notes"
										@onchange="async e => await UpdateNotesAsync(row, e.Value?.ToString() ?? string.Empty)">@row.ReviewerNotes</textarea>

									<div class="issues-table-container">
										<table class="issues-table">
											<thead>
												<tr>
													<th>Status</th>
													<th>Issue</th>
													<th>Action</th>
												</tr>
											</thead>
											<tbody>
												@if (row.Issues.Count == 0)
												{
													<tr>
														<td colspan="3" class="empty-issues">No issues yet. Add one below.</td>
													</tr>
												}
												@foreach (var issue in row.Issues)
												{
													<tr class="@(issue.IsClaimedFix ? "claimed-fix" : string.Empty)">
														<td>
															<button class="issue-state @GetIssueStateCss(issue.State)"
																@onclick="async () => await CycleIssueStateAsync(row, issue)">
																@GetIssueStateLabel(issue.State)
															</button>
														</td>
														<td>
															@if (issue.IsEditing)
															{
																<input class="issue-edit-input"
																	value="@issue.EditText"
																	@oninput="e => issue.EditText = e.Value?.ToString() ?? string.Empty"
																	@onkeydown="async e => await HandleIssueEditKeyDownAsync(row, issue, e)"
																	@onblur="async () => await CommitIssueEditAsync(row, issue)"
																	@ref="issue.EditInputRef" />
															}
															else
															{
																<div class="issue-description" title="Click to edit" @onclick="async () => await StartIssueEditAsync(issue)">@issue.Description</div>
															}
															<div class="issue-guid">@issue.Guid</div>
															@if (issue.IsClaimedFix)
															{
																<div class="claim-chip">Claimed fix</div>
															}
														</td>
														<td>
															<button class="btn btn-sm btn-outline-danger" @onclick="async () => await DeleteIssueAsync(row, issue)">Delete</button>
														</td>
													</tr>
												}
											</tbody>
											<tfoot>
												<tr class="issue-entry-row">
													<td colspan="2">
														<input class="issue-entry-input" placeholder="Issue description"
															@ref="row.PendingIssueInputRef"
															value="@row.PendingIssueDescription"
															@oninput="e => row.PendingIssueDescription = e.Value?.ToString() ?? string.Empty"
															@onkeydown="async e => await HandleIssueInputKeyDownAsync(row, e)" />
													</td>
													<td>
														<button class="btn btn-sm btn-outline-primary" @onclick="async () => await AddIssueAsync(row)">Add</button>
													</td>
												</tr>
											</tfoot>
										</table>
									</div>
								</div>
							</div>
						</div>
					}
				}
			</div>
		</section>
	}

	@if (_isRendering)
	{
		<div class="rendering-status" role="status" aria-live="polite">
			<div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
			<span>@_progressMessage</span>
		</div>
	}

	@if (_comparisonRows.Count > 0)
	{
		<div class="diff-legend" aria-label="Difference legend">
			<span class="legend-item"><span class="legend-swatch missing-svg"></span>Missing from SVG</span>
			<span class="legend-item"><span class="legend-swatch extra-svg"></span>Extra in SVG</span>
			<span class="legend-item"><span class="legend-swatch recolor"></span>Different color</span>
		</div>
	}
</div>

@code {
	private const long MaxFileBytes = 100 * 1024 * 1024;
	private const double MaxPageDisplayWidthPx = 380;
	private const double DiffRenderScale = 2.0;

	private readonly List<PageViewModel> _pages = [];
	private readonly List<ComparisonRow> _comparisonRows = [];
	private readonly HashSet<string> _claimedFieldGuids = new(StringComparer.OrdinalIgnoreCase);
	private RenderResult? _renderResult;
	private SelectedFile? _docxFile;
	private SelectedFile? _pdfFile;
	private bool _isRendering;
	private string? _statusMessage;
	private string? _errorMessage;
	private string? _workspaceImportName;
	private string _progressMessage = "Preparing render...";
	private AppMode _activeMode = AppMode.Comparison;
	private IssueSetPayload? _importedIssueSet;
	private int? _pendingIssueFocusPageNumber;

	private bool _canSimpleRender => _docxFile is not null && !_isRendering;
	private bool _canCompareRender => _docxFile is not null && _pdfFile is not null && !_isRendering;
	private bool _canExportWorkspace => _docxFile is not null && _pdfFile is not null && !_isRendering;

	protected override void OnInitialized()
	{
		LoadClaimedFieldGuidsFromQuery();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!_pendingIssueFocusPageNumber.HasValue)
		{
			return;
		}

		var pageNumber = _pendingIssueFocusPageNumber.Value;
		_pendingIssueFocusPageNumber = null;
		var row = _comparisonRows.FirstOrDefault(candidate => candidate.PageNumber == pageNumber);
		if (row is null)
		{
			return;
		}

		await row.PendingIssueInputRef.FocusAsync();
	}

	private void SetMode(AppMode mode)
	{
		_activeMode = mode;
		_errorMessage = null;
		_statusMessage = null;
	}

	private string GetModeTabCss(AppMode mode) => _activeMode == mode ? "active" : string.Empty;

	private static string DescribeFile(SelectedFile file)
	{
		return $"{file.Name} ({file.Size / 1024d / 1024d:F1} MB)";
	}

	private void LoadClaimedFieldGuidsFromQuery()
	{
		var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
		var query = ParseQueryValues(uri.Query);
		AppendClaimedGuids(query, "ClaimedFieldGuids");
		AppendClaimedGuids(query, "ClaimedFiedGuids");
	}

	private static Dictionary<string, List<string>> ParseQueryValues(string queryString)
	{
		var result = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
		if (string.IsNullOrWhiteSpace(queryString))
		{
			return result;
		}

		var trimmed = queryString.StartsWith('?') ? queryString[1..] : queryString;
		if (string.IsNullOrWhiteSpace(trimmed))
		{
			return result;
		}

		var pairs = trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries);
		for (var i = 0; i < pairs.Length; i++)
		{
			var pair = pairs[i];
			var separator = pair.IndexOf('=');
			var rawKey = separator >= 0 ? pair[..separator] : pair;
			var rawValue = separator >= 0 ? pair[(separator + 1)..] : string.Empty;
			var key = Uri.UnescapeDataString(rawKey.Replace('+', ' '));
			var value = Uri.UnescapeDataString(rawValue.Replace('+', ' '));

			if (!result.TryGetValue(key, out var values))
			{
				values = [];
				result[key] = values;
			}

			values.Add(value);
		}

		return result;
	}

	private void AppendClaimedGuids(Dictionary<string, List<string>> query, string key)
	{
		if (!query.TryGetValue(key, out var values))
		{
			return;
		}

		for (var i = 0; i < values.Count; i++)
		{
			var value = values[i];
			if (string.IsNullOrWhiteSpace(value))
			{
				continue;
			}

			var parts = value.Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
			for (var partIndex = 0; partIndex < parts.Length; partIndex++)
			{
				_claimedFieldGuids.Add(parts[partIndex]);
			}
		}
	}

	private async Task OnSimpleDocxSelected(InputFileChangeEventArgs args)
	{
		await SetDocxFileAsync(args.File);
	}

	private async Task OnComparisonDocxSelected(InputFileChangeEventArgs args)
	{
		await SetDocxFileAsync(args.File);
	}

	private async Task OnComparisonPdfSelected(InputFileChangeEventArgs args)
	{
		await SetPdfFileAsync(args.File);
	}

	private async Task OnWorkspaceZipSelected(InputFileChangeEventArgs args)
	{
		if (args.File is null)
		{
			return;
		}

		_errorMessage = null;
		_statusMessage = null;

		try
		{
			var selectedZip = await ReadSelectedFileAsync(args.File, ".zip");
			if (selectedZip is null)
			{
				return;
			}

			_workspaceImportName = selectedZip.Name;
			await ImportWorkspaceZipAsync(selectedZip.Content);
			_statusMessage = "Workspace ZIP imported. Render + Compare to apply issue set page-by-page.";
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
		}
	}

	private async Task SetDocxFileAsync(IBrowserFile? file)
	{
		if (file is null)
		{
			return;
		}

		try
		{
			var selected = await ReadSelectedFileAsync(file, ".docx", ".dotx");
			if (selected is null)
			{
				return;
			}

			_docxFile = selected;
			_errorMessage = null;
			_statusMessage = $"DOCX selected: {DescribeFile(selected)}.";
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
		}
	}

	private async Task SetPdfFileAsync(IBrowserFile? file)
	{
		if (file is null)
		{
			return;
		}

		try
		{
			var selected = await ReadSelectedFileAsync(file, ".pdf");
			if (selected is null)
			{
				return;
			}

			_pdfFile = selected;
			_errorMessage = null;
			_statusMessage = $"Reference PDF selected: {DescribeFile(selected)}.";
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
		}
	}

	private static async Task<SelectedFile?> ReadSelectedFileAsync(IBrowserFile file, params string[] allowedExtensions)
	{
		var extension = Path.GetExtension(file.Name);
		if (allowedExtensions.Length > 0 && !allowedExtensions.Any(e => string.Equals(e, extension, StringComparison.OrdinalIgnoreCase)))
		{
			throw new InvalidOperationException($"Unsupported file type: {extension}");
		}

		await using var stream = file.OpenReadStream(MaxFileBytes);
		using var memory = new MemoryStream();
		await stream.CopyToAsync(memory);
		return CreateSelectedFile(file.Name, file.Size, memory.ToArray());
	}

	private static SelectedFile CreateSelectedFile(string name, long size, byte[] content)
	{
		return new SelectedFile(name, size, content, ComputeContentHash(content));
	}

	private static string ComputeContentHash(byte[] content)
	{
		return Convert.ToHexStringLower(SHA256.HashData(content));
	}

	private async Task RenderSimpleAsync()
	{
		await RenderInternalAsync(requireReferencePdf: false);
	}

	private async Task RenderComparisonAsync()
	{
		await RenderInternalAsync(requireReferencePdf: true);
	}

	private async Task RenderInternalAsync(bool requireReferencePdf)
	{
		if (_docxFile is null)
		{
			return;
		}

		if (requireReferencePdf && _pdfFile is null)
		{
			_errorMessage = "Comparison mode requires a reference PDF.";
			return;
		}

		_errorMessage = null;
		_statusMessage = null;
		_isRendering = true;
		_progressMessage = "Rendering DOCX...";
		_pages.Clear();
		_comparisonRows.Clear();
		_renderResult = null;
		StateHasChanged();

		try
		{
			using var docStream = new MemoryStream(_docxFile.Content, writable: false);
			var options = new RenderOptions
			{
				EmbedFonts = true,
				FieldUpdate = new FieldUpdateOptions(),
				SourceFilename = _docxFile.Name
			};

			using var renderCts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
			_renderResult = await new DocxRenderer(options).RenderAsync(docStream, renderCts.Token);

			var svgPages = _renderResult.ToSvgPages();
			for (var i = 0; i < _renderResult.Pages.Count; i++)
			{
				var page = _renderResult.Pages[i];
				var widthPx = page.WidthPoints * (96d / 72d);
				var heightPx = page.HeightPoints * (96d / 72d);
				var scale = Math.Min(1d, MaxPageDisplayWidthPx / widthPx);

				var pageModel = new PageViewModel(
					page.PageNumber,
					NormalizeSvgForPreview(svgPages[i]),
					widthPx * scale,
					heightPx * scale);
				_pages.Add(pageModel);

				if (requireReferencePdf)
				{
					var comparisonRow = new ComparisonRow
					{
						PageNumber = i + 1,
						SvgMarkup = pageModel.SvgMarkup,
						DisplayWidthPx = pageModel.DisplayWidthPx,
						DisplayHeightPx = pageModel.DisplayHeightPx,
						FullWidthPoints = page.WidthPoints,
						FullHeightPoints = page.HeightPoints
					};
					ApplyImportedIssueSet(comparisonRow);
					_comparisonRows.Add(comparisonRow);
				}

				_progressMessage = $"Rendered page {i + 1} of {_renderResult.Pages.Count}...";
				StateHasChanged();
				await Task.Yield();
			}

			if (!requireReferencePdf)
			{
				var iterationText = _renderResult.FieldUpdateResult is null
					? string.Empty
					: $" Field update iterations: {_renderResult.FieldUpdateResult.IterationsRequired}.";
				_statusMessage = $"Rendered {_pages.Count} pages from {_docxFile.Name}.{iterationText}";
				return;
			}

			_progressMessage = "Converting reference PDF to images...";
			StateHasChanged();

			var pdfBase64 = Convert.ToBase64String(_pdfFile!.Content);
			var referencePngs = await JS.InvokeAsync<string[]>("visualDiff.renderPdfPages", pdfBase64, DiffRenderScale);

			for (var i = 0; i < referencePngs.Length; i++)
			{
				if (i >= _comparisonRows.Count)
				{
					_comparisonRows.Add(new ComparisonRow
					{
						PageNumber = i + 1,
						DisplayWidthPx = MaxPageDisplayWidthPx,
						DisplayHeightPx = MaxPageDisplayWidthPx * 1.414
					});
				}

				_comparisonRows[i].ReferencePngDataUri = referencePngs[i];
				_progressMessage = $"Prepared reference page {i + 1} of {referencePngs.Length}...";
				StateHasChanged();
				await Task.Yield();
			}

			_progressMessage = "Computing visual differences...";
			StateHasChanged();
			await Task.Delay(30);

			for (var i = 0; i < _comparisonRows.Count; i++)
			{
				var row = _comparisonRows[i];
				if (row.ReferencePngDataUri is null || string.IsNullOrWhiteSpace(row.SvgMarkup))
				{
					continue;
				}

				_progressMessage = $"Diffing page {i + 1} of {_comparisonRows.Count}...";
				StateHasChanged();

				try
				{
					var referenceSize = await JS.InvokeAsync<ImageSize>(
						"visualDiff.getImageSize",
						row.ReferencePngDataUri);

					var svgPng = await JS.InvokeAsync<string>(
						"visualDiff.rasteriseSvg",
						$"svg-page-{row.PageNumber}",
						referenceSize.Width,
						referenceSize.Height);

					var diff = await JS.InvokeAsync<DiffResult>(
						"visualDiff.computeDiff",
						row.ReferencePngDataUri,
						svgPng);

					row.DiffPngDataUri = diff.DiffImageDataUri;
					row.MatchPercent = diff.MatchPercent;
					row.WhitePercent = diff.WhitePercent;
					row.MissingFromSvgPercent = diff.MissingFromSvgPercent;
					row.ExtraInSvgPercent = diff.ExtraInSvgPercent;
					row.RecolorPercent = diff.RecolorPercent;
					row.FooterBaselineDeltaPx = diff.FooterBaselineDeltaPx;
				}
				catch
				{
					row.DiffPngDataUri = null;
					row.MatchPercent = null;
				}

				StateHasChanged();
				await Task.Yield();
			}

			await RestorePageReviewsAsync();
			await InjectClaimedFixPlaceholdersAsync();
			StateHasChanged();

			var totalMatch = _comparisonRows
				.Where(r => r.MatchPercent.HasValue)
				.Select(r => r.MatchPercent!.Value)
				.DefaultIfEmpty(0)
				.Average();

			_statusMessage = $"Compared {_comparisonRows.Count} pages. Average match: {totalMatch:F1}%.";
		}
		catch (OperationCanceledException)
		{
			_errorMessage = "Rendering timed out. The document may trigger a pathological layout case.";
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
		}
		finally
		{
			_isRendering = false;
		}
	}

	private async Task ExportWorkspaceZipAsync()
	{
		if (_docxFile is null || _pdfFile is null)
		{
			return;
		}

		try
		{
			using var memory = new MemoryStream();
			using (var archive = new ZipArchive(memory, ZipArchiveMode.Create, leaveOpen: true))
			{
				WriteZipEntry(archive, _docxFile.Name, _docxFile.Content);
				WriteZipEntry(archive, _pdfFile.Name, _pdfFile.Content);

				var issueSet = BuildIssueSetPayload();
				var issueBytes = Encoding.UTF8.GetBytes(JsonSerializer.Serialize(issueSet, new JsonSerializerOptions
				{
					WriteIndented = true
				}));
				WriteZipEntry(archive, "issue-set.json", issueBytes);
			}

			var fileName = $"render-workspace-{DateTime.UtcNow:yyyyMMdd-HHmmss}.zip";
			await JS.InvokeVoidAsync(
				"demoDownload.downloadBytes",
				fileName,
				"application/zip",
				Convert.ToBase64String(memory.ToArray()));

			_statusMessage = $"Exported workspace ZIP: {fileName}";
			_errorMessage = null;
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
		}
	}

	private static void WriteZipEntry(ZipArchive archive, string entryName, byte[] content)
	{
		var entry = archive.CreateEntry(entryName, CompressionLevel.Optimal);
		using var stream = entry.Open();
		stream.Write(content);
	}

	private async Task ImportWorkspaceZipAsync(byte[] zipContent)
	{
		using var memory = new MemoryStream(zipContent, writable: false);
		using var archive = new ZipArchive(memory, ZipArchiveMode.Read, leaveOpen: false);

		var docxEntry = archive.Entries.FirstOrDefault(e =>
		{
			var ext = Path.GetExtension(e.Name);
			return string.Equals(ext, ".docx", StringComparison.OrdinalIgnoreCase)
				|| string.Equals(ext, ".dotx", StringComparison.OrdinalIgnoreCase);
		});
		var pdfEntry = archive.Entries.FirstOrDefault(e => string.Equals(Path.GetExtension(e.Name), ".pdf", StringComparison.OrdinalIgnoreCase));
		var issueEntry = archive.Entries.FirstOrDefault(e => string.Equals(e.Name, "issue-set.json", StringComparison.OrdinalIgnoreCase));

		if (docxEntry is null || pdfEntry is null)
		{
			throw new InvalidOperationException("Workspace ZIP must contain both a DOCX/DOTX file and a PDF file.");
		}

		_docxFile = CreateSelectedFile(docxEntry.Name, docxEntry.Length, await ReadZipEntryAsync(docxEntry));
		_pdfFile = CreateSelectedFile(pdfEntry.Name, pdfEntry.Length, await ReadZipEntryAsync(pdfEntry));

		if (issueEntry is not null)
		{
			var issueJson = Encoding.UTF8.GetString(await ReadZipEntryAsync(issueEntry));
			_importedIssueSet = JsonSerializer.Deserialize<IssueSetPayload>(issueJson, new JsonSerializerOptions
			{
				PropertyNameCaseInsensitive = true
			});
		}
		else
		{
			_importedIssueSet = null;
		}

		_pages.Clear();
		_comparisonRows.Clear();
		_renderResult = null;
		_activeMode = AppMode.Comparison;
		await Task.CompletedTask;
	}

	private static async Task<byte[]> ReadZipEntryAsync(ZipArchiveEntry entry)
	{
		await using var stream = entry.Open();
		using var memory = new MemoryStream();
		await stream.CopyToAsync(memory);
		return memory.ToArray();
	}

	private IssueSetPayload BuildIssueSetPayload()
	{
		return new IssueSetPayload
		{
			Version = 1,
			GeneratedUtc = DateTimeOffset.UtcNow,
			ClaimedFieldGuids = _claimedFieldGuids.OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList(),
			Pages = _comparisonRows.Select(row => new IssueSetPage
			{
				PageNumber = row.PageNumber,
				Notes = row.ReviewerNotes,
				Issues = row.Issues.Select(issue => new IssueSetIssue
				{
					Guid = issue.Guid,
					Description = issue.Description,
					State = issue.State
				}).ToList()
			}).ToList()
		};
	}

	private void ApplyImportedIssueSet(ComparisonRow row)
	{
		if (_importedIssueSet is null)
		{
			return;
		}

		var importedPage = _importedIssueSet.Pages.FirstOrDefault(p => p.PageNumber == row.PageNumber);
		if (importedPage is null)
		{
			return;
		}

		row.ReviewerNotes = importedPage.Notes ?? string.Empty;
		row.Issues.Clear();

		for (var i = 0; i < importedPage.Issues.Count; i++)
		{
			var importedIssue = importedPage.Issues[i];
			var isImportedClaimed = _claimedFieldGuids.Contains(importedIssue.Guid);
			var importedState = isImportedClaimed && importedIssue.State == IssueState.Denied
				? IssueState.Unknown
				: importedIssue.State;
			row.Issues.Add(new PageIssue
			{
				Guid = importedIssue.Guid,
				Description = importedIssue.Description,
				State = importedState,
				IsClaimedFix = isImportedClaimed
			});
		}
	}

	private string BuildReviewStorageKey()
	{
		return _docxFile is null ? "none" : $"docx-sha256:{_docxFile.ContentHash}";
	}

	private string BuildLegacyReviewStorageKey()
	{
		var docxPart = _docxFile is null ? "none" : $"{_docxFile.Name}:{_docxFile.Size}";
		var pdfPart = _pdfFile is null ? "none" : $"{_pdfFile.Name}:{_pdfFile.Size}";
		return $"{docxPart}|{pdfPart}";
	}

	private async Task RestorePageReviewsAsync()
	{
		var storageKey = BuildReviewStorageKey();
		var legacyStorageKey = BuildLegacyReviewStorageKey();
		foreach (var row in _comparisonRows)
		{
			var stored = await JS.InvokeAsync<StoredPageReview?>("visualDiff.reviewStore.getPage", storageKey, row.PageNumber);
			var restoredFromLegacyKey = false;
			if (stored is null && !string.Equals(storageKey, legacyStorageKey, StringComparison.Ordinal))
			{
				stored = await JS.InvokeAsync<StoredPageReview?>("visualDiff.reviewStore.getPage", legacyStorageKey, row.PageNumber);
				restoredFromLegacyKey = stored is not null;
			}

			if (stored is null)
			{
				continue;
			}

			row.ReviewerNotes = stored.Notes ?? string.Empty;
			for (var i = 0; i < stored.Issues.Count; i++)
			{
				var storedIssue = stored.Issues[i];
				var existing = row.Issues.FirstOrDefault(issue => string.Equals(issue.Guid, storedIssue.Guid, StringComparison.OrdinalIgnoreCase));
				var isClaimed = _claimedFieldGuids.Contains(storedIssue.Guid);
				if (existing is null)
				{
					// If the fix is claimed and the tester previously marked it Denied, reset to Unknown for re-verification.
					var resolvedState = isClaimed && storedIssue.State == IssueState.Denied
						? IssueState.Unknown
						: storedIssue.State;
					row.Issues.Add(new PageIssue
					{
						Guid = storedIssue.Guid,
						Description = storedIssue.Description,
						State = resolvedState,
						IsClaimedFix = isClaimed
					});
				}
				else
				{
					existing.Description = storedIssue.Description;
					existing.State = storedIssue.State;
					existing.IsClaimedFix = existing.IsClaimedFix || isClaimed;
					// Reset to Unknown for re-verification if claimed and previously Denied.
					if (isClaimed && existing.State == IssueState.Denied)
					{
						existing.State = IssueState.Unknown;
					}
				}
			}

			if (restoredFromLegacyKey)
			{
				await SavePageReviewAsync(row);
			}
		}
	}

	/// <summary>
	/// For each GUID in _claimedFieldGuids that is not already present in any row, inject a
	/// placeholder issue on the matching page (determined by the "p{n}-" prefix) so the tester
	/// knows a fix has been claimed and needs verification.
	/// </summary>
	private async Task InjectClaimedFixPlaceholdersAsync()
	{
		foreach (var guid in _claimedFieldGuids)
		{
			// Check whether any row already has this issue.
			var alreadyPresent = _comparisonRows.Any(r =>
				r.Issues.Any(i => string.Equals(i.Guid, guid, StringComparison.OrdinalIgnoreCase)));
			if (alreadyPresent)
			{
				continue;
			}

			// Determine page number from "p{n}-" prefix, e.g. "p2-footer-date-format" → page 2.
			ComparisonRow? targetRow = null;
			var match = System.Text.RegularExpressions.Regex.Match(guid, @"^p(\d+)-");
			if (match.Success && int.TryParse(match.Groups[1].Value, out var pageNumber))
			{
				targetRow = _comparisonRows.FirstOrDefault(r => r.PageNumber == pageNumber);
			}

			// Fall back to page 1 if we can't determine the page.
			targetRow ??= _comparisonRows.FirstOrDefault();
			if (targetRow is null)
			{
				continue;
			}

			// Build a human-readable description from the GUID slug.
			var slug = match.Success ? guid[(match.Length)..] : guid;
			var description = $"[Claimed fix] {slug.Replace('-', ' ')}";

			targetRow.Issues.Add(new PageIssue
			{
				Guid = guid,
				Description = description,
				State = IssueState.Unknown,
				IsClaimedFix = true
			});
			await SavePageReviewAsync(targetRow);
		}
	}

	private async Task SavePageReviewAsync(ComparisonRow row)
	{
		var storageKey = BuildReviewStorageKey();
		var payload = new StoredPageReview
		{
			Notes = row.ReviewerNotes,
			Issues = row.Issues.Select(issue => new StoredIssueReview
			{
				Guid = issue.Guid,
				Description = issue.Description,
				State = issue.State
			}).ToList()
		};

		await JS.InvokeVoidAsync("visualDiff.reviewStore.setPage", storageKey, row.PageNumber, payload);
	}

	private async Task HandleIssueInputKeyDownAsync(ComparisonRow row, KeyboardEventArgs args)
	{
		if (!string.Equals(args.Key, "Enter", StringComparison.Ordinal))
		{
			return;
		}

		if (string.IsNullOrWhiteSpace(row.PendingIssueDescription))
		{
			FocusNextIssueInput(row.PageNumber);
			return;
		}

		await AddIssueAsync(row);
	}

	private async Task CycleIssueStateAsync(ComparisonRow row, PageIssue issue)
	{
		issue.State = issue.State switch
		{
			IssueState.Unknown => IssueState.Confirmed,
			IssueState.Confirmed => IssueState.Denied,
			_ => IssueState.Unknown
		};
		await SavePageReviewAsync(row);
	}

	private async Task AddIssueAsync(ComparisonRow row)
	{
		if (string.IsNullOrWhiteSpace(row.PendingIssueDescription))
		{
			return;
		}

		var issueGuid = $"p{row.PageNumber}-user-{Guid.NewGuid():N}";
		var isClaimedFix = _claimedFieldGuids.Contains(issueGuid);
		row.Issues.Add(new PageIssue
		{
			Guid = issueGuid,
			Description = row.PendingIssueDescription.Trim(),
			State = isClaimedFix ? IssueState.Unknown : IssueState.Denied,
			IsClaimedFix = isClaimedFix
		});
		row.PendingIssueDescription = string.Empty;
		_pendingIssueFocusPageNumber = row.PageNumber;
		await SavePageReviewAsync(row);
	}

	private async Task DeleteIssueAsync(ComparisonRow row, PageIssue issue)
	{
		row.Issues.Remove(issue);
		await SavePageReviewAsync(row);
	}

	private async Task StartIssueEditAsync(PageIssue issue)
	{
		issue.EditText = issue.Description;
		issue.IsEditing = true;
		await Task.Yield();
		await JS.InvokeVoidAsync("focusElement", issue.EditInputRef);
	}

	private async Task CommitIssueEditAsync(ComparisonRow row, PageIssue issue)
	{
		if (!issue.IsEditing)
		{
			return;
		}

		var trimmed = issue.EditText.Trim();
		if (!string.IsNullOrWhiteSpace(trimmed))
		{
			issue.Description = trimmed;
		}

		issue.IsEditing = false;
		await SavePageReviewAsync(row);
	}

	private async Task HandleIssueEditKeyDownAsync(ComparisonRow row, PageIssue issue, KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
		{
			await CommitIssueEditAsync(row, issue);
		}
		else if (e.Key == "Escape")
		{
			issue.IsEditing = false;
		}
	}

	private async Task UpdateNotesAsync(ComparisonRow row, string value)
	{
		row.ReviewerNotes = value;
		await SavePageReviewAsync(row);
	}

	private static string GetIssueStateCss(IssueState state)
	{
		return state switch
		{
			IssueState.Confirmed => "state-confirmed",
			IssueState.Denied => "state-denied",
			_ => "state-unknown"
		};
	}

	private static string GetIssueStateLabel(IssueState state)
	{
		return state switch
		{
			IssueState.Confirmed => "OK",
			IssueState.Denied => "X",
			_ => "?"
		};
	}

	private void FocusNextIssueInput(int currentPageNumber)
	{
		var nextPageNumber = _comparisonRows
			.Where(row => row.PageNumber > currentPageNumber)
			.Select(row => (int?)row.PageNumber)
			.FirstOrDefault();

		_pendingIssueFocusPageNumber = nextPageNumber ?? currentPageNumber;
	}

	private static string GetSeverityCss(double percentage)
	{
		return percentage > 1d
			? "severity-disastrous"
			: percentage > 0.2d
				? "severity-bad"
				: "severity-ok";
	}

	private async Task DownloadPdfAsync()
	{
		if (_renderResult is null || _docxFile is null)
		{
			return;
		}

		var fileName = Path.GetFileNameWithoutExtension(_docxFile.Name) + ".pdf";
		var pdfBytes = _renderResult.ToPdf();

		await JS.InvokeVoidAsync(
			"demoDownload.downloadBytes",
			fileName,
			"application/pdf",
			Convert.ToBase64String(pdfBytes));
	}

	private static string NormalizeSvgForPreview(string svgMarkup)
	{
		if (string.IsNullOrWhiteSpace(svgMarkup))
		{
			return svgMarkup;
		}

		var openTagEnd = svgMarkup.IndexOf('>');
		if (openTagEnd <= 0)
		{
			return svgMarkup;
		}

		var openTag = svgMarkup[..openTagEnd];
		openTag = Regex.Replace(openTag, "\\swidth=\"[^\"]*\"", string.Empty, RegexOptions.IgnoreCase);
		openTag = Regex.Replace(openTag, "\\sheight=\"[^\"]*\"", string.Empty, RegexOptions.IgnoreCase);

		if (!openTag.Contains("preserveAspectRatio=", StringComparison.OrdinalIgnoreCase))
		{
			openTag += " preserveAspectRatio=\"xMinYMin meet\"";
		}

		if (openTag.Contains("style=", StringComparison.OrdinalIgnoreCase))
		{
			openTag = Regex.Replace(
				openTag,
				"style=\"([^\"]*)\"",
				m => $"style=\"{m.Groups[1].Value};display:block;width:100%;height:100%\"",
				RegexOptions.IgnoreCase);
		}
		else
		{
			openTag += " style=\"display:block;width:100%;height:100%\"";
		}

		return openTag + svgMarkup[openTagEnd..];
	}

