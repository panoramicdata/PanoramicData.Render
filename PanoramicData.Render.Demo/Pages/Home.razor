@page "/"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using PanoramicData.Render
@using System.Text.RegularExpressions
@inject IJSRuntime JS

<PageTitle>PanoramicData Render Demo</PageTitle>

<div class="demo-shell">
	<p class="demo-subtitle">Upload a DOCX file to render, and optionally a reference PDF for visual comparison.</p>

	<div class="intake-row">
		<section class="intake @(_isDragging ? "is-dragging" : string.Empty)"
				 @ondragenter="OnDragEnter"
				 @ondragleave="OnDragLeave"
				 @ondragover:preventDefault="true"
				 @ondrop="OnDrop"
				 @ondrop:preventDefault="true">
			<InputFile class="file-input-overlay"
					   OnChange="OnDocxSelected"
					   accept=".docx,.dotx" />
			<div class="intake-content">
				<strong>DOCX / DOTX file</strong>
				<span>@(_selectedDocx is null ? "Drop or click to browse" : _selectedDocx.Name)</span>
			</div>
		</section>

		<section class="intake">
			<InputFile class="file-input-overlay"
					   OnChange="OnPdfSelected"
					   accept=".pdf" />
			<div class="intake-content">
				<strong>Reference PDF (optional)</strong>
				<span>@(_selectedPdf is null ? "Drop or click to browse" : _selectedPdf.Name)</span>
			</div>
		</section>
	</div>

	<div class="actions">
		<button class="btn btn-primary" @onclick="RenderAndCompareAsync" disabled="@(!_canRender)">Render</button>
		<button class="btn btn-outline-secondary" @onclick="DownloadPdfAsync" disabled="@(_renderResult is null || _isRendering)">Download PDF</button>
	</div>

	@if (!string.IsNullOrWhiteSpace(_statusMessage))
	{
		<div class="alert alert-success" role="status">@_statusMessage</div>
	}

	@if (!string.IsNullOrWhiteSpace(_errorMessage))
	{
		<div class="alert alert-danger" role="alert">@_errorMessage</div>
	}

	@if (_isRendering)
	{
		<div class="alert alert-info" role="status">@_progressMessage</div>
	}

	@if (_comparisonRows.Count > 0)
	{
		<div class="comparison-grid">
			<div class="comparison-header">
				<div>Reference (PDF)</div>
				<div>Rendered (SVG)</div>
				<div>Difference</div>
			</div>
			@foreach (var row in _comparisonRows)
			{
				<div class="comparison-row">
					<div class="comparison-cell">
						<header>Page @row.PageNumber</header>
						@if (row.ReferencePngDataUri is not null)
						{
							<img src="@row.ReferencePngDataUri" alt="Reference page @row.PageNumber" />
						}
						else
						{
							<div class="placeholder">No reference</div>
						}
					</div>
					<div class="comparison-cell">
						<header>Page @row.PageNumber</header>
						<div class="svg-container" id="svg-page-@row.PageNumber">
							@((MarkupString)row.SvgMarkup)
						</div>
					</div>
					<div class="comparison-cell">
						<header>
							Page @row.PageNumber
							@if (row.MatchPercent.HasValue)
							{
								<span class="match-badge @(row.MatchPercent >= 95 ? "good" : row.MatchPercent >= 80 ? "fair" : "poor")">
									@($"{row.MatchPercent:F1}% match")
								</span>
							}
						</header>
						@if (row.DiffPngDataUri is not null)
						{
							<img src="@row.DiffPngDataUri" alt="Diff page @row.PageNumber" />
						}
						else
						{
							<div class="placeholder">@(row.ReferencePngDataUri is null ? "No reference" : "Pending…")</div>
						}
					</div>
				</div>
			}
		</div>
	}
	else if (_pages.Count > 0)
	{
		<section class="page-strip" aria-label="Rendered pages">
			@foreach (var renderedPage in _pages)
			{
				<article class="page-card">
					<header>Page @renderedPage.PageNumber</header>
					<div class="page-canvas" style="width:@($"{renderedPage.DisplayWidthPx:F0}px");height:@($"{renderedPage.DisplayHeightPx:F0}px")">
						@((MarkupString)renderedPage.SvgMarkup)
					</div>
				</article>
			}
		</section>
	}

	@if (_comparisonRows.Count > 0)
	{
		<div class="diff-legend" aria-label="Difference legend">
			<span class="legend-item"><span class="legend-swatch same"></span>Same</span>
			<span class="legend-item"><span class="legend-swatch missing-svg"></span>Missing from SVG</span>
			<span class="legend-item"><span class="legend-swatch extra-svg"></span>Extra in SVG</span>
			<span class="legend-item"><span class="legend-swatch recolor"></span>Different color</span>
		</div>
	}
</div>

@code {
	private const long MaxFileBytes = 100 * 1024 * 1024;
	private const double MaxPageDisplayWidthPx = 380;
	private const double DiffRenderScale = 2.0;

	private readonly List<PageViewModel> _pages = [];
	private readonly List<ComparisonRow> _comparisonRows = [];
	private IBrowserFile? _selectedDocx;
	private IBrowserFile? _selectedPdf;
	private RenderResult? _renderResult;
	private bool _isRendering;
	private bool _isDragging;
	private string? _statusMessage;
	private string? _errorMessage;
	private string _progressMessage = "Rendering…";

	private bool _canRender => _selectedDocx is not null && !_isRendering;

	private void OnDragEnter(DragEventArgs _) => _isDragging = true;
	private void OnDragLeave(DragEventArgs _) => _isDragging = false;
	private void OnDrop(DragEventArgs _) => _isDragging = false;

	private Task OnDocxSelected(InputFileChangeEventArgs args)
	{
		_selectedDocx = args.File;
		_errorMessage = null;
		_statusMessage = $"DOCX: {_selectedDocx.Name} ({_selectedDocx.Size / 1024d / 1024d:F1} MB).";
		return Task.CompletedTask;
	}

	private Task OnPdfSelected(InputFileChangeEventArgs args)
	{
		_selectedPdf = args.File;
		_errorMessage = null;
		_statusMessage = $"Reference PDF: {_selectedPdf.Name} ({_selectedPdf.Size / 1024d / 1024d:F1} MB).";
		return Task.CompletedTask;
	}

	private async Task RenderAndCompareAsync()
	{
		if (_selectedDocx is null)
		{
			return;
		}

		_errorMessage = null;
		_statusMessage = null;
		_isRendering = true;
		_progressMessage = "Rendering DOCX…";
		_pages.Clear();
		_comparisonRows.Clear();
		_renderResult = null;
		StateHasChanged();

		try
		{
			var extension = Path.GetExtension(_selectedDocx.Name);
			if (!string.Equals(extension, ".docx", StringComparison.OrdinalIgnoreCase)
				&& !string.Equals(extension, ".dotx", StringComparison.OrdinalIgnoreCase))
			{
				throw new InvalidOperationException("Only .docx and .dotx files are supported.");
			}

			// 1. Render DOCX → SVG pages
			await using var sourceStream = _selectedDocx.OpenReadStream(MaxFileBytes);
			using var docStream = new MemoryStream();
			await sourceStream.CopyToAsync(docStream).ConfigureAwait(false);
			docStream.Position = 0;

			var options = new RenderOptions
			{
				EmbedFonts = true,
				FieldUpdate = new FieldUpdateOptions(),
				SourceFilename = _selectedDocx.Name
			};

			using var renderCts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
			_renderResult = await new DocxRenderer(options).RenderAsync(docStream, renderCts.Token);

			// Build page view models using document-level SVG export for shared numbering state
			var svgPages = _renderResult.ToSvgPages();
			for (var i = 0; i < _renderResult.Pages.Count; i++)
			{
				var page = _renderResult.Pages[i];
				var widthPx = page.WidthPoints * (96d / 72d);
				var heightPx = page.HeightPoints * (96d / 72d);
				var scale = Math.Min(1d, MaxPageDisplayWidthPx / widthPx);

				_pages.Add(new PageViewModel(
					page.PageNumber,
					NormalizeSvgForPreview(svgPages[i]),
					widthPx * scale,
					heightPx * scale));
			}

			// 2. If no reference PDF, just show the strip
			if (_selectedPdf is null)
			{
				var iterationText = _renderResult.FieldUpdateResult is null
					? ""
					: $" Field update iterations: {_renderResult.FieldUpdateResult.IterationsRequired}.";
				_statusMessage = $"Rendered {_pages.Count} pages from {_selectedDocx.Name}.{iterationText}";
				return;
			}

			// 3. Read reference PDF
			_progressMessage = "Converting reference PDF to images…";
			StateHasChanged();

			await using var pdfSource = _selectedPdf.OpenReadStream(MaxFileBytes);
			using var pdfStream = new MemoryStream();
			await pdfSource.CopyToAsync(pdfStream).ConfigureAwait(false);
			var pdfBase64 = Convert.ToBase64String(pdfStream.ToArray());

			// 4. Render PDF pages to PNG via JS
			var referencePngs = await JS.InvokeAsync<string[]>("visualDiff.renderPdfPages", pdfBase64, DiffRenderScale);

			// 5. Build comparison rows (one per max(pages, refPages))
			var maxPages = Math.Max(_pages.Count, referencePngs.Length);
			for (var i = 0; i < maxPages; i++)
			{
				var svgPage = i < _pages.Count ? _pages[i] : null;
				var refPng = i < referencePngs.Length ? referencePngs[i] : null;

				var fullWidthPt = i < _renderResult.Pages.Count ? _renderResult.Pages[i].WidthPoints : 595;
				var fullHeightPt = i < _renderResult.Pages.Count ? _renderResult.Pages[i].HeightPoints : 842;

				_comparisonRows.Add(new ComparisonRow
				{
					PageNumber = i + 1,
					SvgMarkup = svgPage?.SvgMarkup ?? string.Empty,
					DisplayWidthPx = svgPage?.DisplayWidthPx ?? MaxPageDisplayWidthPx,
					DisplayHeightPx = svgPage?.DisplayHeightPx ?? (MaxPageDisplayWidthPx * 1.414),
					FullWidthPoints = fullWidthPt,
					FullHeightPoints = fullHeightPt,
					ReferencePngDataUri = refPng,
					DiffPngDataUri = null,
					MatchPercent = null
				});
			}

			_progressMessage = "Computing visual differences…";
			StateHasChanged();

			// Need a render cycle so SVG elements exist in DOM before rasterising
			await Task.Delay(100);

			// 6. For each page with both reference and rendered SVG, compute diff
			for (var i = 0; i < _comparisonRows.Count; i++)
			{
				var row = _comparisonRows[i];
				if (row.ReferencePngDataUri is null || i >= _pages.Count)
				{
					continue;
				}

				_progressMessage = $"Diffing page {i + 1} of {_comparisonRows.Count}…";
				StateHasChanged();
				await Task.Delay(10); // yield for UI update

				try
				{
					// Rasterise the SVG at the same pixel dimensions as the PDF PNG
					// PDF.js at scale N: pageWidthPt × N pixels. Match that exactly.
					var svgPng = await JS.InvokeAsync<string>(
						"visualDiff.rasteriseSvg",
						$"svg-page-{row.PageNumber}",
						(int)(row.FullWidthPoints * DiffRenderScale),
						(int)(row.FullHeightPoints * DiffRenderScale));

					// Compute pixel diff
					var diff = await JS.InvokeAsync<DiffResult>(
						"visualDiff.computeDiff",
						row.ReferencePngDataUri,
						svgPng);

					row.DiffPngDataUri = diff.DiffImageDataUri;
					row.MatchPercent = diff.MatchPercent;
				}
				catch
				{
					row.DiffPngDataUri = null;
					row.MatchPercent = null;
				}

				StateHasChanged();
			}

			var totalMatch = _comparisonRows
				.Where(r => r.MatchPercent.HasValue)
				.Select(r => r.MatchPercent!.Value)
				.DefaultIfEmpty(0)
				.Average();

			_statusMessage = $"Compared {_comparisonRows.Count} pages. Average match: {totalMatch:F1}%.";
		}
		catch (OperationCanceledException)
		{
			_errorMessage = "Rendering timed out after 30 seconds. The document may trigger a pathological layout case.";
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
		}
		finally
		{
			_isRendering = false;
		}
	}

	private async Task DownloadPdfAsync()
	{
		if (_renderResult is null || _selectedDocx is null)
		{
			return;
		}

		var fileName = Path.GetFileNameWithoutExtension(_selectedDocx.Name) + ".pdf";
		var pdfBytes = _renderResult.ToPdf();

		await JS.InvokeVoidAsync(
			"demoDownload.downloadBytes",
			fileName,
			"application/pdf",
			Convert.ToBase64String(pdfBytes));
	}

	private static string NormalizeSvgForPreview(string svgMarkup)
	{
		if (string.IsNullOrWhiteSpace(svgMarkup))
		{
			return svgMarkup;
		}

		var openTagEnd = svgMarkup.IndexOf('>');
		if (openTagEnd <= 0)
		{
			return svgMarkup;
		}

		var openTag = svgMarkup[..openTagEnd];
		openTag = Regex.Replace(openTag, "\\swidth=\"[^\"]*\"", string.Empty, RegexOptions.IgnoreCase);
		openTag = Regex.Replace(openTag, "\\sheight=\"[^\"]*\"", string.Empty, RegexOptions.IgnoreCase);

		if (!openTag.Contains("preserveAspectRatio=", StringComparison.OrdinalIgnoreCase))
		{
			openTag += " preserveAspectRatio=\"xMinYMin meet\"";
		}

		if (openTag.Contains("style=", StringComparison.OrdinalIgnoreCase))
		{
			openTag = Regex.Replace(
				openTag,
				"style=\"([^\"]*)\"",
				m => $"style=\"{m.Groups[1].Value};display:block;width:100%;height:100%\"",
				RegexOptions.IgnoreCase);
		}
		else
		{
			openTag += " style=\"display:block;width:100%;height:100%\"";
		}

		return openTag + svgMarkup[openTagEnd..];
	}

	private sealed record PageViewModel(int PageNumber, string SvgMarkup, double DisplayWidthPx, double DisplayHeightPx);

	private sealed class ComparisonRow
	{
		public int PageNumber { get; set; }
		public string SvgMarkup { get; set; } = string.Empty;
		public double DisplayWidthPx { get; set; }
		public double DisplayHeightPx { get; set; }
		public double FullWidthPoints { get; set; }
		public double FullHeightPoints { get; set; }
		public string? ReferencePngDataUri { get; set; }
		public string? DiffPngDataUri { get; set; }
		public double? MatchPercent { get; set; }
	}

	private sealed class DiffResult
	{
		public string? DiffImageDataUri { get; set; }
		public double MatchPercent { get; set; }
		public int MismatchCount { get; set; }
		public int TotalPixels { get; set; }
	}
}
